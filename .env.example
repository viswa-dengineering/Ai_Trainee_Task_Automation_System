# Google Gemini API Key (Get free from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Sheets Spreadsheet Name or ID
SPREADSHEET_NAME_OR_ID=Trainee Management System

# Path to Google Cloud Service Account JSON Key file
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# Optional: Gemini Model Name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
